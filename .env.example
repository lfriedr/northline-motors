# Port the API (and, in production, the website) listens on
PORT=4000
# Password for /dealer, and the token it hands out
DEALER_PASSWORD=demo
DEALER_TOKEN=demo-dealer
# Where the SQLite database file lives
# DB_PATH=./server/data/dealer.db
# Which credit adapter to use (only "mock" exists in the demo)
# CREDIT_PROVIDER=mock
# Set to 1 when deployed behind a proxy (Heroku, Render, Azure) so rate limits see real visitor IPs
# TRUST_PROXY=1
